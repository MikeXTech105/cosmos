{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=false"
  },
  "Jwt": {
    "Issuer": "Cosmos.API",
    "Audience": "Cosmos.Client",
    "SigningKey": "<store-in-secret-manager-or-vault>",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-frontend-domain.example"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowMinutes": 1
  }
}
