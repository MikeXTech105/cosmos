FROM node:20 AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/40-cosmos-runtime-config.sh /docker-entrypoint.d/40-cosmos-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/40-cosmos-runtime-config.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
