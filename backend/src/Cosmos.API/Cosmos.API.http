@Cosmos.API_HostAddress = https://localhost:7125
@accessToken =
@refreshToken =

POST {{Cosmos.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@cosmos.com",
  "password": "Admin@123"
}

###

GET {{Cosmos.API_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{Cosmos.API_HostAddress}}/api/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

GET {{Cosmos.API_HostAddress}}/health
Accept: application/json
