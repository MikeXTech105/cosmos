{
  "info": {
    "name": "Cosmos.API RBAC",
    "_postman_id": "79fd3905-22fb-4d20-8d2b-536a2a22b948",
    "description": "Postman collection for Cosmos.API RBAC authentication and authorization backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5001" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "pm.collectionVariables.set('userId', body.data.userId);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cosmos.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/refresh-token"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Get Roles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/roles?pageNumber=1&pageSize=20&sortBy=role_name&sortDirection=asc"
          }
        },
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roleName\": \"MANAGER\",\n  \"description\": \"Manager role\",\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/roles"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users?pageNumber=1&pageSize=20&searchTerm=admin"
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane.doe@cosmos.com\",\n  \"password\": \"Password@123\",\n  \"roleId\": \"{{roleId}}\",\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        }
      ]
    },
    {
      "name": "Permissions",
      "item": [
        {
          "name": "Get Role Permissions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/permissions/roles/{{roleId}}"
          }
        },
        {
          "name": "Upsert Role Permission",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": \"{{roleId}}\",\n  \"pageId\": null,\n  \"sectionId\": null,\n  \"fieldId\": null,\n  \"canView\": true,\n  \"canCreate\": true,\n  \"canEdit\": true,\n  \"canDelete\": false,\n  \"canFullAccess\": false\n}"
            },
            "url": "{{baseUrl}}/api/permissions/roles/{{roleId}}"
          }
        }
      ]
    }
  ]
}
